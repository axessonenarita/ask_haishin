NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Google Analytics 4 Measurement ID (例: G-XXXXXXXXXX)。空ならGAは読み込まれない
NEXT_PUBLIC_GA_ID=
# Sentry DSN (例: https://xxxxx@oXXX.ingest.sentry.io/XXXX)。空ならSentryは初期化されない
NEXT_PUBLIC_SENTRY_DSN=
# Sentry Session Replayを有効にする場合は1。バンドルサイズが増えるので必要時のみ
NEXT_PUBLIC_SENTRY_REPLAY=
# Sentry ソースマップアップロード用 (任意・ビルド時のみ)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# 祝詞アプリ（/norito）の通知。`npx web-push generate-vapid-keys` で作った鍵を入れる
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 通知の送り主（連絡先。mailto: か https:）
VAPID_SUBJECT=
# 奏上会前の自動通知（/api/norito/cron）を呼ぶときの合言葉
CRON_SECRET=
