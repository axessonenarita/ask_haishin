NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Google Analytics 4 Measurement ID (例: G-XXXXXXXXXX)。空ならGAは読み込まれない
NEXT_PUBLIC_GA_ID=
# Sentry DSN (例: https://xxxxx@oXXX.ingest.sentry.io/XXXX)。空ならSentryは初期化されない
NEXT_PUBLIC_SENTRY_DSN=
# Sentry Session Replayを有効にする場合は1。バンドルサイズが増えるので必要時のみ
NEXT_PUBLIC_SENTRY_REPLAY=
# Sentry ソースマップアップロード用 (任意・ビルド時のみ)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Stripe (奉納音叉)。narita@axessone.net の Stripe アカウントから取得
# テストキーは pk_test_ / sk_test_ で始まる。本番キーは pk_live_ / sk_live_
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe Dashboard の Webhooks で /api/stripe/webhook を登録した際の署名シークレット
STRIPE_WEBHOOK_SECRET=
